{
  "name": "swapcircle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:regressions": "node --import tsx scripts/verify-regressions.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "@wizardconnect/react": "0.2.6",
    "cashscript": "0.14.0",
    "express": "5.3.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.3.0",
    "@wizardconnect/wallet": "0.2.4",
    "eslint": "10.15.0",
    "nostr-tools": "^2.23.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "^8.21.3"
  }
}
