HOST=127.0.0.1
PORT=5173
DATA_DIR=./data
# Set the exact external HTTPS origin behind a reverse proxy, without a path.
# Leave blank for local development. This also marks the session cookie Secure.
PUBLIC_ORIGIN=
# Optional overrides for your own BCH nodes.
CHIPNET_ELECTRUM_HOST=chipnet.bch.ninja
MAINNET_ELECTRUM_HOST=bch.imaginary.cash
# Leave blank to use WizardConnect's default encrypted relays.
VITE_WIZARD_RELAYS=
# Public configuration only. These values never contain spending keys.
# Set your own Mainnet token-aware prize address before submitting to BLAZE.
VITE_PRIZE_ADDRESS=
